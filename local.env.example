# Copy to local.env (untracked) and adjust. Environment variables win over
# this file; this file wins over the defaults in scripts/env.sh.
# ~ is expanded; relative paths resolve against the project root.

# one = x86_64 ABIv11 (AROS One and other distributions), mainline = ABIv1.
AROS_TARGET=one

# Cross toolchain directories (containing x86_64-aros-gcc / -g++) and the
# matching SDK "Developer" directories, per ABI.
#AROS_ONE_GCC_ROOT=~/aros/abiv11/toolchain
#AROS_ONE_SDK=~/aros/abiv11/Developer
#AROS_MAINLINE_GCC_ROOT=~/aros/mainline/toolchain
#AROS_MAINLINE_SDK=~/aros/mainline/Developer
