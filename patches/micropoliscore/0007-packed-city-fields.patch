+// miscHist is a stream of 16-bit host-order words after loadFileData.
+// File fields occupy exactly two words even when Quad/long is 64-bit.
+static Quad readHistoryLong(const short *words)
+{
+    const uint32_t bits=(uint32_t(uint16_t(words[0]))<<16)|uint16_t(words[1]);
+    // Explicit sign extension, without alignment, aliasing or host-endian casts.
+    return bits<=0x7fffffffu?Quad(bits):Quad(int64_t(bits)-0x100000000LL);
+}
+
+static void writeHistoryLong(short *words,Quad value)
+{
+    const uint32_t bits=uint32_t(value);
+    words[0]=short(uint16_t(bits>>16));
+    words[1]=short(uint16_t(bits));
+}
